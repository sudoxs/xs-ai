{
  "_comment": "Benchmark fixtures. Each case: {id, category, kind, input, expect, negative?}. Deterministic/offline. 'negative' marks cases where the correct answer is NOT to flag — a failure there is a false positive.",
  "cases": [
    {
      "id": "svc-id-http",
      "category": "service-identification",
      "kind": "fingerprint",
      "input": {"port": 8080, "nmap": "8080/tcp open  http    Apache httpd 2.4.49"},
      "expect": {"service": "http", "version": "2.4.49", "reliability": "confirmed"}
    },
    {
      "id": "svc-id-ssh",
      "category": "service-identification",
      "kind": "fingerprint",
      "input": {"port": 22, "nmap": "22/tcp open  ssh  OpenSSH 8.2p1 Ubuntu"},
      "expect": {"service": "ssh", "version": "8.2p1"}
    },
    {
      "id": "cve-in-range",
      "category": "cve-relevance",
      "kind": "applicability",
      "input": {"service": "http", "version": "2.4.49",
                "affected": {"version_start": "2.4.49", "version_end_including": "2.4.49"}},
      "expect": {"status": "strongly_suspected", "confidence": "medium"}
    },
    {
      "id": "cve-out-of-range",
      "category": "cve-relevance",
      "kind": "applicability",
      "negative": true,
      "input": {"service": "http", "version": "2.4.58",
                "affected": {"version_start": "2.4.49", "version_end_including": "2.4.49"}},
      "expect": {"status": "not_applicable"}
    },
    {
      "id": "cve-unknown-version",
      "category": "cve-relevance",
      "kind": "applicability",
      "negative": true,
      "input": {"service": "http", "version": "",
                "affected": {"version_start": "2.4.0"}},
      "expect": {"status": "unverified", "confidence": "low"}
    },
    {
      "id": "nvd-drops-inapplicable",
      "category": "source-quality",
      "kind": "nvd_parse",
      "input": {
        "service": "http", "product": "Apache httpd", "version": "2.4.49",
        "response": {"vulnerabilities": [
          {"cve": {"id": "CVE-2021-41773",
            "descriptions": [{"lang": "en", "value": "Path traversal"}],
            "metrics": {"cvssMetricV31": [{"cvssData": {"baseSeverity": "CRITICAL"}}]},
            "configurations": [{"nodes": [{"cpeMatch": [{"versionStartIncluding": "2.4.49", "versionEndIncluding": "2.4.49"}]}]}]}},
          {"cve": {"id": "CVE-1111-2222",
            "descriptions": [{"lang": "en", "value": "Only 1.x"}],
            "configurations": [{"nodes": [{"cpeMatch": [{"versionEndExcluding": "2.0.0"}]}]}]}}
        ]}
      },
      "expect": {"kept_cves": ["CVE-2021-41773"]}
    },
    {
      "id": "default-config-research-http",
      "category": "default-config-research",
      "kind": "kb_lookup",
      "input": {"service": "http", "port": 80},
      "expect": {"titles": {"__contains__": "default credentials"}, "categories": ["attack-surface", "authentication", "configuration"]}
    },
    {
      "id": "auth-anonymous-redis",
      "category": "auth-weakness-id",
      "kind": "classify",
      "input": {"kind": "anon-check", "service": "redis", "exit_code": 0, "output": "# Server\nredis_version:6.0.16"},
      "expect": {"status": "confirmed", "auth_state": "anonymous_access", "confidence": "high"}
    },
    {
      "id": "auth-redis-requires-auth",
      "category": "auth-weakness-id",
      "kind": "classify",
      "negative": true,
      "input": {"kind": "anon-check", "service": "redis", "exit_code": 1, "output": "NOAUTH Authentication required."},
      "expect": {"status": "not_applicable"}
    },
    {
      "id": "auth-default-cred-accepted",
      "category": "auth-weakness-id",
      "kind": "classify",
      "input": {"kind": "default-cred", "service": "http", "exit_code": 0, "output": "200"},
      "expect": {"status": "confirmed", "auth_state": "credential_validated"}
    },
    {
      "id": "auth-default-cred-rejected",
      "category": "false-positive-reduction",
      "kind": "classify",
      "negative": true,
      "input": {"kind": "default-cred", "service": "http", "exit_code": 0, "output": "401"},
      "expect": {"status": "not_applicable"}
    },
    {
      "id": "hypotheses-redis-critical",
      "category": "hypothesis-generation",
      "kind": "hypotheses",
      "input": {"port": 6379, "asset": "10.0.0.5",
                "nmap": "6379/tcp open  redis   Redis key-value store 6.0.16"},
      "expect": {"top_severity": "critical", "well_formed": true}
    },
    {
      "id": "technique-first-splunk-rce",
      "category": "technique-first",
      "kind": "hypotheses",
      "input": {"port": 8000, "asset": "10.0.0.5",
                "nmap": "8000/tcp open  http  Splunkd httpd"},
      "expect": {"top_severity": "critical", "categories": ["technique"]}
    },
    {
      "id": "product-normalization-splunk",
      "category": "fingerprint-normalization",
      "kind": "fingerprint",
      "input": {"port": 8089, "nmap": "8089/tcp open ssl/http Splunkd httpd (free license; remote login disabled)"},
      "expect": {"service": "ssl/http", "product_id": "splunk"}
    },
    {
      "id": "technique-first-postgres-rce",
      "category": "technique-first",
      "kind": "hypotheses",
      "input": {"port": 5432, "asset": "10.0.0.5",
                "nmap": "5432/tcp open  postgresql  PostgreSQL DB 11.7"},
      "expect": {"top_severity": "critical", "categories": ["technique"]}
    },
    {
      "id": "gtfobins-tail-sudo",
      "category": "privesc-lookup",
      "kind": "gtfobins",
      "input": {"sudo": "User mark may run the following commands on box:\n    (ALL) NOPASSWD: /usr/bin/tail"},
      "expect": {"matched": ["tail"], "functions": ["file-read"]}
    },
    {
      "id": "gtfobins-no-false-privesc",
      "category": "false-positive-reduction",
      "kind": "gtfobins",
      "negative": true,
      "input": {"sudo": "(ALL) NOPASSWD: /usr/local/bin/totallysafe"},
      "expect": {"matched": []}
    },
    {
      "id": "llm-never-mints-cve",
      "category": "false-positive-reduction",
      "kind": "cve_discipline",
      "negative": true,
      "input": {
        "port": 8000,
        "nmap": "8000/tcp open http Splunkd httpd",
        "model_json": "{\"hypotheses\":[{\"observation\":\"default creds (CVE-2020-1938)\",\"category\":\"authentication\",\"severity\":\"high\",\"confidence\":\"medium\",\"status\":\"potential_config\",\"cves\":[\"CVE-2020-1938\",\"CVE-2019-1683\"],\"references\":[\"https://nvd.nist.gov/vuln/detail/CVE-2020-1938\"]}]}"
      },
      "expect": {"leaked_cves": [], "nvd_links": false, "cve_in_text": false}
    },
    {
      "id": "evidence-quality-wellformed",
      "category": "evidence-quality",
      "kind": "hypotheses",
      "input": {"port": 80, "asset": "10.0.0.5",
                "nmap": "80/tcp open  http   Apache httpd 2.4.49"},
      "expect": {"well_formed": true, "categories": ["attack-surface", "authentication", "configuration"]}
    },
    {
      "id": "chain-links-access",
      "category": "attack-chain-reasoning",
      "kind": "chains",
      "input": {
        "asset": "10.0.0.5",
        "hypotheses": [
          {"id": "H001", "category": "attack-surface", "status": "strongly_suspected", "observation": "manager exposed"},
          {"id": "H002", "category": "authentication", "status": "confirmed", "observation": "default creds accepted"},
          {"id": "H003", "category": "configuration", "status": "potential_config", "observation": "WAR upload enabled"}
        ]
      },
      "expect": {"linked_ids": ["H001", "H002", "H003"]}
    },
    {
      "id": "chain-excludes-not-applicable",
      "category": "false-positive-reduction",
      "kind": "chains",
      "negative": true,
      "input": {
        "asset": "10.0.0.5",
        "hypotheses": [
          {"id": "H001", "category": "attack-surface", "status": "strongly_suspected", "observation": "iface"},
          {"id": "H009", "category": "authentication", "status": "not_applicable", "observation": "anon denied"}
        ]
      },
      "expect": {"chain_count": 0}
    },
    {
      "id": "report-sections",
      "category": "reporting-accuracy",
      "kind": "report",
      "input": {
        "target": "10.0.0.5",
        "findings": ["[H002] VALIDATED: default creds"],
        "hypotheses": [{"id": "H002", "service": "http", "severity": "high", "confidence": "high", "status": "confirmed", "observation": "default creds"}],
        "attack_chains": [{"id": "C001", "title": "access chain", "steps": ["a", "b"], "confidence": "low", "impact": "access"}],
        "want_sections": ["## Findings", "## Research Hypotheses", "## Attack Chains"]
      },
      "expect": {"has_sections": ["## Findings", "## Research Hypotheses", "## Attack Chains"]}
    },

    {
      "id": "url-norm-basic",
      "category": "crawler",
      "kind": "url_normalize",
      "input": {"url": "/page?a=1#frag", "base": "https://example.com/dir/index.html"},
      "expect": {"normalized": "https://example.com/page?a=1"}
    },
    {
      "id": "url-norm-trailing-slash",
      "category": "crawler",
      "kind": "url_normalize",
      "input": {"url": "https://example.com/path/", "base": ""},
      "expect": {"normalized": "https://example.com/path/"}
    },
    {
      "id": "ssrf-localhost",
      "category": "crawler",
      "kind": "ssrf_blocked",
      "input": {"host": "127.0.0.1"},
      "expect": {"blocked": true}
    },
    {
      "id": "ssrf-metadata",
      "category": "crawler",
      "kind": "ssrf_blocked",
      "input": {"host": "169.254.169.254"},
      "expect": {"blocked": true}
    },
    {
      "id": "ssrf-normal-host",
      "category": "crawler",
      "kind": "ssrf_blocked",
      "negative": true,
      "input": {"host": "example.com"},
      "expect": {"blocked": false}
    },
    {
      "id": "same-origin-yes",
      "category": "crawler",
      "kind": "same_origin",
      "input": {"url1": "https://example.com/a", "url2": "https://example.com/b"},
      "expect": {"same_origin": true}
    },
    {
      "id": "same-origin-no",
      "category": "crawler",
      "kind": "same_origin",
      "input": {"url1": "https://example.com/a", "url2": "https://evil.com/b"},
      "expect": {"same_origin": false}
    },
    {
      "id": "nav-layer-valid",
      "category": "navigator",
      "kind": "navigator_layer",
      "input": {
        "name": "test-layer",
        "annotations": [
          {"technique_id": "T1078", "evidence_level": "observed"},
          {"technique_id": "T1190", "evidence_level": "ai_recommended"}
        ]
      },
      "expect": {"valid": true, "technique_count": 2, "has_legend": true}
    },
    {
      "id": "ot-modbus-detect",
      "category": "caldera-ot",
      "kind": "ot_detect",
      "input": {"ports": [502, 80, 443]},
      "expect": {"count": 1}
    },
    {
      "id": "ot-multiple-detect",
      "category": "caldera-ot",
      "kind": "ot_detect",
      "input": {"ports": [502, 102, 4840]},
      "expect": {"count": 3}
    },
    {
      "id": "ot-no-detect",
      "category": "caldera-ot",
      "kind": "ot_detect",
      "negative": true,
      "input": {"ports": [80, 443, 22, 8080]},
      "expect": {"count": 0}
    },
    {
      "id": "advisory-format",
      "category": "vendor-advisories",
      "kind": "advisory_format",
      "input": {"id": "CVE-2024-1234", "vendor": "Apache", "product": "httpd",
                "cves": ["CVE-2024-1234"], "title": "Path traversal"},
      "expect": {"has_context": true, "has_source_label": true}
    },
    {
      "id": "mini-yaml-parse",
      "category": "atomic-red-team",
      "kind": "mini_yaml",
      "input": {"yaml_text": "attack_technique: T1059.001\ndisplay_name: PowerShell\natomic_tests:\n  - name: Invoke-Expression test\n    auto_generated_guid: abc12345\n    description: Test PS execution\n    supported_platforms:\n      - windows\n    executor:\n      name: powershell\n      command: |\n        Write-Host test\n"},
      "expect": {"test_count": 1, "has_name": true}
    },
    {
      "id": "web-classify-api",
      "category": "web-analysis",
      "kind": "web_classify",
      "input": {"node": {"url": "https://example.com/api/v1/users?id=1", "title": "", "content_type": "application/json", "status": 200, "headers": {}}},
      "expect": {"has_evidence": true}
    },

    {
      "id": "agent-cmd-dedup-identical",
      "category": "agent-dedup",
      "kind": "agent_normalize",
      "input": {"cmd1": "nmap -sV -p 80 10.0.0.5", "cmd2": "nmap -sV -p 80 10.0.0.5"},
      "expect": {"same": true}
    },
    {
      "id": "agent-cmd-dedup-reorder",
      "category": "agent-dedup",
      "kind": "agent_normalize",
      "input": {"cmd1": "nmap -sV -p 80 10.0.0.5", "cmd2": "nmap -p 80 -sV 10.0.0.5"},
      "expect": {"same": true}
    },
    {
      "id": "agent-cmd-dedup-different",
      "category": "agent-dedup",
      "kind": "agent_normalize",
      "negative": true,
      "input": {"cmd1": "nmap -sV -p 80 10.0.0.5", "cmd2": "nmap -sV -p 443 10.0.0.5"},
      "expect": {"same": false}
    },
    {
      "id": "agent-cmd-dedup-whitespace",
      "category": "agent-dedup",
      "kind": "agent_normalize",
      "input": {"cmd1": "nmap  -sV   10.0.0.5 ;", "cmd2": "nmap -sV 10.0.0.5"},
      "expect": {"same": true}
    },
    {
      "id": "registry-fallback-aware",
      "category": "model-registry",
      "kind": "registry_fallback",
      "input": {
        "models": [
          {"name": "fast-model", "provider": "ollama", "model": "fast", "capabilities": ["fast"], "context": 4096},
          {"name": "reasoning-model", "provider": "ollama", "model": "reason", "capabilities": ["reasoning"], "context": 16384}
        ],
        "exclude": "reasoning-model",
        "role": "planner"
      },
      "expect": {"fallback_name": "fast-model"}
    }
  ]
}
